

# --- serie diaria (historico) ---
HISTORY_RETENCAO_DIAS=400
# Teto de envios novos consultados por varredura (o custo de frete de envio despachado
# nunca muda, entao e buscado uma vez e guardado pra sempre).
FRETES_POR_VARREDURA=300

# --- reposicao de estoque ---
# Dias entre fazer o pedido e a mercadoria estar disponivel pra vender.
PRAZO_ENTREGA_DIAS=15
# De quanto em quanto tempo voce faz pedido (7 = semanal, 15 = quinzenal).
CICLO_COMPRA_DIAS=15
# Nivel de servico em z-score: 1.65 ~ 95%. Maior = menos ruptura, mais capital parado.
NIVEL_SERVICO_Z=1.65

# --- Tiny (API v3, OAuth2) ---
# APLICATIVO PROPRIO deste servico, separado do que o tiny-pedidos-nf usa.
# Precisa apenas de LEITURA de produtos: e de la que vem o precoCusto.
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=
TINY_REDIRECT_URI=https://SEU-DOMINIO-ANALYTICS/oauth/tiny/callback
# So preencha se o portal do Tiny mostrar enderecos diferentes destes padroes.
# TINY_AUTH_URL=
# TINY_TOKEN_URL=
# TINY_API_BASE_URL=
CUSTOS_VALIDADE_HORAS=24

# --- Assistente por Telegram ---
# Provedor: 'anthropic' ou 'openrouter'. Vazio = usa a chave que estiver preenchida.
ASSISTENTE_PROVEDOR=
# Id do modelo. Na Anthropic pode ficar vazio (o servico pergunta a API quais existem).
# No OpenRouter e OBRIGATORIO: veja /debug/assistente pra lista dos que aceitam ferramenta.
ASSISTENTE_MODELO=

# Opcao A — Anthropic (exige creditos no console.anthropic.com; a assinatura do Claude NAO serve).
ANTHROPIC_API_KEY=

# Opcao B — OpenRouter (compativel com OpenAI; da acesso a varios modelos com uma chave so).
# ATENCAO: o modelo escolhido PRECISA suportar ferramentas, senao ele ignora as funcoes e
# responde de cabeca — exatamente o que este desenho existe pra impedir.
OPENROUTER_API_KEY=
# Teto de idas e voltas com ferramentas numa pergunta.
ASSISTENTE_MAX_PASSOS=6
ASSISTENTE_MAX_TOKENS=1500

# Token do bot, dado pelo @BotFather no Telegram.
TELEGRAM_BOT_TOKEN=
# Invente uma string aleatoria e longa: ela vira parte do endereco do webhook.
TELEGRAM_WEBHOOK_SECRET=
# Chat ids que podem conversar com o bot, separados por virgula.
# VAZIO = ninguem: o bot so responde informando o proprio chat id, pra voce descobrir o seu.
TELEGRAM_CHAT_IDS=
# Endereco publico deste servico, usado pra registrar o webhook.
BASE_URL=https://SEU-DOMINIO-ANALYTICS

# --- base local (SQLite) ---
# De quanto em quanto tempo a base e alimentada com o que as varreduras acharam.
# A tabela `vendas` so ACUMULA: linha de pedido gravada nunca e apagada por varredura seguinte.
SINCRONIZACAO_INTERVALO_HORAS=6
