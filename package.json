{
  "name": "tiny-analytics",
  "version": "1.0.0",
  "description": "Analises de mercado do Mercado Livre (catalogo/Buy Box e futuras), via API v2/OAuth2. Servico separado do tiny-pedidos-nf.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.1.4"
  },
  "license": "ISC"
}
